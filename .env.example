# 阿里云百炼 DashScope API Key (从 https://bailian.console.aliyun.com 获取)
# 使用前请复制本文件为 .env 并填入真实 Key: cp .env.example .env
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here

# 可选：自定义 OpenAI 兼容端点 (默认使用阿里云百炼兼容端点)
# 留空则使用 settings.py / default.yaml 中的默认端点
DASHSCOPE_BASE_URL=

# 可选：覆盖默认模型名 (须为阿里云千问系列)
QWEN_VISION_MODEL=qwen-vl-max-latest
QWEN_REASONING_MODEL=qwen-plus
